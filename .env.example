# YumeRobo Environment Variables
# Copy this file to .env and fill in your values

# TMDB API Key (required for metadata fetching)
# Get yours at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Telegram Bot Token (optional, for notifications)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram Channel ID (optional, for notifications)
# Can be @channel_username or numeric ID
TELEGRAM_CHANNEL_ID=

# Public site URL.
#
# This is inlined at BUILD time into canonical/og:url tags, so a placeholder
# value here ends up in every prerendered page. `bun run cli deploy` refuses to
# deploy while it still points at example.com.
#
# Falls back to https://yumerobo.moe (the CLI default) when unset.
PUBLIC_SITE_URL=

# Cloudflare Pages project name for CLI deploy
CLOUDFLARE_PAGES_PROJECT=yumerobo

# Cloudflare Pages production branch for CLI deploy
CLOUDFLARE_PRODUCTION_BRANCH=main

# Optional: slow.pics scraping presents this User-Agent (defaults to a current Chrome UA)
SLOWPICS_USER_AGENT=

# Optional: raises the GitHub API rate limit for the yacomp-web version check
# (`bun run check:yacomp`, `bun run update:yacomp`). The CI workflow supplies its own token.
GITHUB_TOKEN=
