# Cloudflare Pages Headers

# Baseline security headers for all routes
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# SvelteKit content-hashed chunks are immutable by construction
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are stable, versioned by filename
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Posters are named by a generated asset id, but the card-sized sibling and the
# OG render are rewritten in place by `backfill-card-posters` /
# `backfill-social-cards`, so they cannot be immutable. A week is long enough to
# keep repeat visits cheap and short enough that a regenerated poster lands.
/posters/*.avif
  Content-Type: image/avif
  Content-Disposition: inline
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/posters/*.jpg
  Content-Type: image/jpeg
  Content-Disposition: inline
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/posters/*.png
  Content-Type: image/png
  Content-Disposition: inline
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/posters/*.webp
  Content-Type: image/webp
  Content-Disposition: inline
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# OG / social images (per release plus the home card)
/og/*.jpg
  Content-Type: image/jpeg
  Content-Disposition: inline
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Raw MediaInfo files are content-addressed by hash, immutable
/mediainfo/*
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: inline
  Cache-Control: public, max-age=31536000, immutable

# Pinned third-party viewer releases are checksum-verified before commit
/vendor/yacomp-web/*
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

# Comparison sidecars are regenerated in place by `comparison-sync`
/comparisons/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

# JSON
/*.json
  Content-Type: application/json; charset=utf-8
