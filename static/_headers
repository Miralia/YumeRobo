# Cloudflare Pages Headers

# Baseline security headers for all routes
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# SvelteKit content-hashed chunks are immutable by construction
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are stable, versioned by filename
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Ensure images are displayed inline
/posters/*.avif
  Content-Type: image/avif
  Content-Disposition: inline
  Cache-Control: public, max-age=31536000, immutable

/posters/*.jpg
  Content-Type: image/jpeg
  Content-Disposition: inline
  Cache-Control: public, max-age=31536000, immutable

/posters/*.png
  Content-Type: image/png
  Content-Disposition: inline
  Cache-Control: public, max-age=31536000, immutable

/posters/*.webp
  Content-Type: image/webp
  Content-Disposition: inline
  Cache-Control: public, max-age=31536000, immutable

# Raw MediaInfo files are content-addressed by hash, immutable
/mediainfo/*
  Content-Type: text/plain; charset=utf-8
  Content-Disposition: inline
  Cache-Control: public, max-age=31536000, immutable

# JSON
/*.json
  Content-Type: application/json; charset=utf-8
